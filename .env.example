# Copy this file to .env and fill in real values. Never commit .env.

# --- Required ---
OPENAI_API_KEY=sk-...

# --- LLM ---
OPENAI_MODEL=gpt-5-mini
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3

# --- Database (SQLite file, relative to the app's working directory) ---
DATABASE_PATH=./data/insurance_support.db

# --- Vector store (ChromaDB persistent dir) ---
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=insurance_faq_collection
# If "true", the FAQ seed script will attempt to download the deccan-ai/insuranceQA-v2
# dataset from Hugging Face; otherwise (or on failure) it uses the bundled sample FAQ set.
FAQ_USE_HUGGINGFACE_DATASET=false
FAQ_SAMPLE_SIZE=200

# --- Supervisor / conversation behavior ---
# See app/config.py for why this needs headroom above 3 (a single
# clarification + one specialist dispatch + the final "done" check is
# already 3 decision points on its own).
SUPERVISOR_MAX_ITERATIONS=5
SESSION_TTL_SECONDS=1800

# --- Observability (optional). Leave PHOENIX_COLLECTOR_ENDPOINT unset to disable tracing. ---
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PROJECT_NAME=insurance-support-agents

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./data/insurance_agent.log

# --- API ---
API_CORS_ORIGINS=*
